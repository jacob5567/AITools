#!/usr/bin/env bash
# cope-wt: git worktree plumbing for the COPE cascade (see README.md).
#
#   cope-wt snapshot                  commit the dirty working tree (index untouched) as this run's candidate base
#   cope-wt hook-create               WorktreeCreate hook: JSON on stdin, prints the new worktree path
#   cope-wt hook-remove               WorktreeRemove hook: JSON on stdin
#   cope-wt hook-usage                SubagentStop hook: logs token usage of cope* agents to ~/.claude/cope-usage.tsv
#   cope-wt list                      this run's candidate worktrees
#   cope-wt verify --checks CMD [--checks CMD]... [--oracle "PATHS"] [--parallel] [--all] [--apply] [WT...]
#                                     check candidates not yet verified (or WT.../--all), then print a DECISION line;
#                                     --apply: on DECISION APPLY, also apply it and run cleanup --final
#   cope-wt diffs [--summary] SHA...  candidate diffs vs the snapshot (IDENTICAL / TOO-LARGE shortcuts)
#   cope-wt apply SHA                 apply a candidate's diff to the main working tree
#   cope-wt profile                   print the COPE profile block from the repo's CLAUDE.md (or PROFILE: none)
#   cope-wt forbid [--code] RE PATH...  rule check: fail, listing matches, if the ERE appears under PATH
#                                     (--code: source files only, comment text ignored)
#   cope-wt require RE PATH...        rule check: fail unless the ERE appears somewhere under PATH
#   cope-wt brief save|path           store the scout's brief from stdin (prints its path) / print the path
#   cope-wt cleanup [--final|--all]   remove this run's worktrees and snapshot (--final: also its brief;
#                                     --all: every run in this repo)
#   cope-wt log REPO PATH CANDIDATES STAGE VERDICT MODELS TASK
#                                     check the fields, then append a dated run line to $COPE_LOG (~/.claude/cope-log.tsv)
#   cope-wt report [N]                token usage per agent and model for the last N runs (default 5)
#
# Runs are keyed by the Claude Code session (CLAUDE_CODE_SESSION_ID, or COPE_RUN), so concurrent
# /cope runs in one repo from different sessions never share snapshots or worktrees.
set -euo pipefail

SNAP_MAX_AGE=${COPE_SNAPSHOT_MAX_AGE:-43200}   # seconds; older snapshots are ignored by hook-create
CHECK_TIMEOUT=${COPE_CHECK_TIMEOUT:-600}
MAX_DIFF_LINES=${COPE_MAX_DIFF_LINES:-1500}
USAGE_LOG=${COPE_USAGE_LOG:-$HOME/.claude/cope-usage.tsv}
DEFAULT_DEPS=(node_modules .venv venv vendor target)
# Artifacts that running checks creates; never part of a snapshot or a candidate even if not gitignored.
JUNK=(':(exclude,glob)**/__pycache__/**' ':(exclude,glob)**/*.pyc' ':(exclude,glob)**/.pytest_cache/**'
      ':(exclude,glob)**/.mypy_cache/**' ':(exclude,glob)**/.ruff_cache/**' ':(exclude,glob)**/.coverage'
      ':(exclude,glob)**/coverage/**' ':(exclude,glob)**/.nyc_output/**' ':(exclude,glob)**/*.tsbuildinfo'
      ':(exclude,glob)**/.DS_Store')
export GIT_AUTHOR_NAME=cope GIT_AUTHOR_EMAIL=cope@localhost GIT_COMMITTER_NAME=cope GIT_COMMITTER_EMAIL=cope@localhost

die() { echo "cope-wt: $*" >&2; exit 1; }

run_id() { printf '%s' "${1:-${COPE_RUN:-${CLAUDE_CODE_SESSION_ID:-default}}}" | sha1sum | cut -c1-10; }
RUN=$(run_id)

common_dir() { git rev-parse --path-format=absolute --git-common-dir; }

main_root() { dirname "$(common_dir)"; }

repo_cache_dir() {
  local h
  h=$(common_dir | sha1sum | cut -c1-12)
  echo "${XDG_CACHE_HOME:-$HOME/.cache}/cope-worktrees/$h"
}

cache_dir() { echo "$(repo_cache_dir)/$RUN"; }

snap_ref() { echo "refs/cope/$RUN/snapshot"; }

# Commit the working tree of $1 (all non-ignored files) on parent $2 using a throwaway index.
tree_commit() {
  local dir=$1 parent=${2:-} idx tree
  idx=$(mktemp)
  # -p keeps the index's mtime, so git still re-reads files edited in the same second as the checkout
  # ("racily clean"); a fresh mtime makes it trust their stat data and miss same-size edits.
  cp -p "$(git -C "$dir" rev-parse --path-format=absolute --git-path index)" "$idx" 2>/dev/null || rm -f "$idx"
  GIT_INDEX_FILE=$idx git -C "$dir" add -A -- . "${JUNK[@]}"
  tree=$(GIT_INDEX_FILE=$idx git -C "$dir" write-tree)
  rm -f "$idx"
  if [[ -n $parent ]]; then
    git -C "$dir" commit-tree "$tree" -p "$parent" -m "cope candidate"
  else
    git -C "$dir" commit-tree "$tree" -m "cope candidate"
  fi
}

snap_sha() { git rev-parse -q --verify "$(snap_ref)^{commit}" 2>/dev/null; }

snap_is_fresh() {
  local sha=$1 t
  t=$(git log -1 --format=%ct "$sha")
  (( $(date +%s) - t < SNAP_MAX_AGE ))
}

# Copy gitignored dependency dirs/files from the main tree into a worktree (reflink on btrfs/xfs).
copy_deps() {
  local root=$1 wt=$2 mode=$3 p entries=()
  [[ $mode == snapshot ]] && entries=("${DEFAULT_DEPS[@]}")
  if [[ -f $root/.worktreeinclude ]]; then
    while IFS= read -r p; do
      p=${p%%#*}; p=${p#/}; p=${p%/}; p=${p//[[:space:]]/}
      [[ -z $p || $p == !* ]] && continue
      entries+=("$p")
    done < "$root/.worktreeinclude"
  fi
  local e src rel
  for e in "${entries[@]}"; do
    for src in "$root"/$e; do
      [[ -e $src ]] || continue
      rel=${src#"$root"/}
      git -C "$root" check-ignore -q "$rel" || continue   # tracked files are already in the worktree
      [[ -e $wt/$rel ]] && continue
      mkdir -p "$(dirname "$wt/$rel")"
      cp -a --reflink=auto "$src" "$wt/$rel"
    done
  done
}

cmd_snapshot() {
  local sha parent=""
  git rev-parse -q --verify HEAD >/dev/null && parent=HEAD
  sha=$(tree_commit "$(git rev-parse --show-toplevel)" "$parent")
  git update-ref "$(snap_ref)" "$sha"
  rm -rf "$(cache_dir)/.results"
  echo "$sha"
}

# Pick this session's snapshot; if the hook can't tell sessions apart, accept exactly one fresh run.
resolve_run_for_hook() {
  local sid=$1 ref sha fresh=()
  [[ -n $sid ]] && RUN=$(run_id "$sid")
  if sha=$(snap_sha) && snap_is_fresh "$sha"; then hook_log "session-match run=$RUN"; return 0; fi
  while IFS= read -r ref; do
    sha=$(git rev-parse "$ref^{commit}")
    snap_is_fresh "$sha" && fresh+=("$ref")
  done < <(git for-each-ref --format='%(refname)' 'refs/cope/*/snapshot')
  if ((${#fresh[@]} == 1)); then
    RUN=$(cut -d/ -f3 <<<"${fresh[0]}")
    hook_log "single-run-fallback run=$RUN (session $sid had no snapshot)"
    return 0
  fi
  hook_log "no-snapshot (${#fresh[@]} fresh runs) -> plain worktree"
  return 1
}

hook_log() {
  local f="${XDG_CACHE_HOME:-$HOME/.cache}/cope-worktrees/hook.log"
  mkdir -p "$(dirname "$f")" && echo "$(date +%FT%T) $(basename "$(main_root)") $*" >> "$f" || true
}

cmd_hook_create() {
  local input cwd name sid root sha path
  input=$(cat)
  cwd=$(jq -r '.cwd // empty' <<<"$input")
  sid=$(jq -r '.session_id // empty' <<<"$input")
  name=$(jq -r '.name // empty' <<<"$input" | tr -c 'A-Za-z0-9._\n-' '_')
  [[ -n $name ]] || name="wt-$(date +%s)-$$"
  [[ -n $cwd ]] && cd "$cwd"
  git rev-parse --git-dir >/dev/null 2>&1 || die "not a git repository: $PWD"
  root=$(main_root)
  if resolve_run_for_hook "$sid"; then
    sha=$(snap_sha)
    path="$(cache_dir)/$name"
    mkdir -p "$(dirname "$path")"
    git -C "$root" worktree add --detach "$path" "$sha" >&2
    copy_deps "$root" "$path" snapshot
  else
    path="$root/.claude/worktrees/$name"
    if git -C "$root" rev-parse -q --verify "refs/heads/worktree-$name" >/dev/null; then
      git -C "$root" worktree add "$path" "worktree-$name" >&2
    else
      git -C "$root" worktree add -b "worktree-$name" "$path" HEAD >&2
    fi
    copy_deps "$root" "$path" default
  fi
  echo "$path"
}

cmd_hook_remove() {
  local input path
  input=$(cat)
  path=$(jq -r '.worktree_path // empty' <<<"$input")
  [[ -n $path && -d $path ]] || exit 0
  git -C "$path" worktree remove --force "$path" >&2 2>/dev/null || rm -rf "$path"
}

# SubagentStop hook. Must never fail or print to stdout: a non-zero exit could block the agent from stopping.
cmd_hook_usage() {
  local input cwd repo=""
  input=$(cat) || exit 0
  cwd=$(jq -r '.cwd // empty' <<<"$input" 2>/dev/null) || cwd=""
  # Agents in candidate worktrees report the worktree as cwd; name the main repo instead.
  [[ -n $cwd ]] && repo=$(cd "$cwd" 2>/dev/null && basename "$(main_root)" 2>/dev/null) || repo=$(basename "${cwd:-?}")
  local script
  script=$(cat <<'PY'
import json, sys, os, time, fcntl, hashlib
ev = json.loads(sys.stdin.read())
agent = ev.get("agent_type") or ""
path = ev.get("agent_transcript_path") or ""
if not agent.startswith("cope") or not os.path.isfile(path):
    sys.exit(0)
KEYS = ("input_tokens", "cache_creation_input_tokens", "cache_read_input_tokens", "output_tokens")
# Visible output characters per output token, measured on this machine's transcripts.
CHARS_PER_TOKEN = 2.1
def read():
    # Each content block of a message is its own transcript entry. Most carry the usage from the start of the
    # stream: the input and cache counts are final, but output_tokens is a few tokens. Only some messages get an
    # entry with a stop_reason and the final usage.
    msgs, final = {}, False
    for line in open(path, encoding="utf-8", errors="replace"):
        try:
            e = json.loads(line)
        except ValueError:
            continue
        m = e.get("message") or {}
        if e.get("type") != "assistant" or "usage" not in m:
            continue
        d = msgs.setdefault(m.get("id"), {"model": m.get("model", "?"), "usage": None, "final": False, "blocks": {}})
        done = m.get("stop_reason") is not None
        if done or not d["final"]:
            u = dict(m["usage"])
            if not done and d["usage"]:
                u["output_tokens"] = max(u.get("output_tokens") or 0, d["usage"].get("output_tokens") or 0)
            d["usage"], d["final"] = u, d["final"] or done
        for b in m.get("content") or []:
            text = b.get("text") or b.get("thinking") or ""
            if b.get("type") == "tool_use":
                text = json.dumps(b.get("input"), ensure_ascii=False)
            if text:
                d["blocks"][hashlib.sha1(text.encode()).hexdigest()] = len(text)
        final = done
    return msgs, final
# SubagentStop can fire before the agent's last message is flushed; wait (bounded) until it is.
deadline = time.time() + float(os.environ.get("COPE_USAGE_WAIT", "15"))
msgs, final = read()
while not final and time.time() < deadline:
    time.sleep(0.3)
    msgs, final = read()
# Totals per message as of now. Without a final usage, output is estimated from the visible content; hidden
# thinking can't be counted, so an estimate is a lower bound.
now = {}
for mid, d in msgs.items():
    t = [d["usage"].get(k) or 0 for k in KEYS]
    est = 0
    if not d["final"]:
        guess = round(sum(d["blocks"].values()) / CHARS_PER_TOKEN)
        if guess > t[3]:
            t[3], est = guess, 1
    now[str(mid)] = [d["model"]] + t + [est]
# SubagentStop fires again when an agent resumes and stops again, and each transcript read is cumulative, so log
# only what changed since this transcript was last logged. Summing the log's rows then gives each agent's total.
log = sys.argv[1]
state_dir = log + ".d"
os.makedirs(state_dir, exist_ok=True)
for name in os.listdir(state_dir):
    p = os.path.join(state_dir, name)
    if time.time() - os.path.getmtime(p) > 7 * 86400:
        os.remove(p)
with open(os.path.join(state_dir, hashlib.sha1(path.encode()).hexdigest()[:16]), "a+") as sf:
    fcntl.flock(sf, fcntl.LOCK_EX)
    sf.seek(0)
    try:
        before = json.loads(sf.read() or "{}")
    except ValueError:
        before = {}
    by_model = {}
    for mid, cur in now.items():
        old = before.get(mid) or [cur[0]] + [0] * 5
        t = by_model.setdefault(cur[0], [0] * 5)
        for i in range(5):
            t[i] += cur[i + 1] - old[i + 1]
    new = not os.path.exists(log)
    with open(log, "a") as f:
        if new:
            f.write("time\tsession\trepo\tagent\tmodel\tinput\tcache_write\tcache_read\toutput\toutput_est\tagents\n")
        first = not before
        for model, t in by_model.items():
            if any(t):
                # agents: 1 on the first row for this transcript, so the report counts spawns, not stops.
                f.write("\t".join([time.strftime("%Y-%m-%dT%H:%M:%S"), (ev.get("session_id") or "")[:8],
                                   sys.argv[2], agent, model.replace("claude-", "")]
                                  + [str(x) for x in t] + [str(int(first))]) + "\n")
                first = False
    sf.seek(0)
    sf.truncate()
    sf.write(json.dumps(now))
PY
)
  # Parse in a detached process so the hook returns at once and never delays the agent.
  if [[ -n ${COPE_USAGE_SYNC:-} ]]; then
    python3 -I -c "$script" "$USAGE_LOG" "$repo" <<<"$input" >/dev/null 2>&1 || true
  else
    setsid python3 -I -c "$script" "$USAGE_LOG" "$repo" <<<"$input" >/dev/null 2>&1 &
  fi
  exit 0
}

LOG_USAGE='usage: cope-wt log REPO PATH CANDIDATES STAGE VERDICT MODELS "TASK"
  PATH: single|weak|code|question   CANDIDATES: executors spawned (a number)
  STAGE: 1|2|3|none (the stage whose attempt was accepted)
  VERDICT: applied|answered|blocked|conflict|clarify
  MODELS: +-joined models of the executors and scouts that attempted it (haiku, sonnet, opus), plus opus-plan
          if cope-planner ran; not the interpreter, profiler or verifier'

# Fields are checked so every run's line reads the same way; nothing is written on a bad field.
cmd_log() {
  local f=${COPE_LOG:-$HOME/.claude/cope-log.tsv} m models=() order
  (($# == 7)) || die "expected 7 fields, got $#
$LOG_USAGE"
  [[ $2 =~ ^(single|weak|code|question)$ ]] || die "bad PATH '$2'
$LOG_USAGE"
  [[ $3 =~ ^[0-9]+$ ]] || die "bad CANDIDATES '$3'
$LOG_USAGE"
  [[ $4 =~ ^(1|2|3|none)$ ]] || die "bad STAGE '$4'
$LOG_USAGE"
  [[ $5 =~ ^(applied|answered|blocked|conflict|clarify)$ ]] || die "bad VERDICT '$5'
$LOG_USAGE"
  for m in $(tr ',+ ' '\n\n\n' <<<"${6,,}"); do
    [[ $m =~ ^(haiku|sonnet|opus-plan|opus)$ ]] || die "bad model '$m' in MODELS '$6'
$LOG_USAGE"
  done
  # Fixed order and no repeats: haiku+sonnet+opus-plan+opus.
  for order in haiku sonnet opus-plan opus; do
    tr ',+ ' '\n\n\n' <<<"${6,,}" | grep -qx "$order" && models+=("$order")
  done
  ((${#models[@]})) || die "MODELS is empty
$LOG_USAGE"
  [[ $1 != *$'\t'* && $7 != *$'\t'* ]] || die "REPO and TASK can't contain tabs"
  mkdir -p "$(dirname "$f")"
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$(date +%F)" "$1" "$2" "$3" "$4" "$5" "$(IFS=+; echo "${models[*]}")" "$7" >> "$f"
  echo "LOGGED $f"
}

cmd_report() {
  local n=${1:-5}
  [[ -f $USAGE_LOG ]] || die "no usage log yet at $USAGE_LOG (is the SubagentStop hook installed?)"
  python3 -I - "$USAGE_LOG" "$n" <<'PY'
import csv, sys, collections
lines = list(csv.reader(open(sys.argv[1]), delimiter="\t"))
# Logs started before output_est and agents existed keep the old header; their newer rows carry the extra columns.
header = lines[0] + [c for c in ("output_est", "agents") if c not in lines[0]]
rows = [dict(zip(header, l)) for l in lines[1:]]
order = []
for r in rows:
    if r["session"] not in order:
        order.append(r["session"])
for s in order[-int(sys.argv[2]):]:
    rs = [r for r in rows if r["session"] == s]
    print(f"== session {s}  repo={rs[0]['repo']}  {rs[0]['time']} .. {rs[-1]['time'][11:]}")
    agg = collections.defaultdict(lambda: [0, 0, 0, 0, 0, 0])
    for r in rs:
        a = agg[(r["agent"], r["model"])]
        # Rows from before the agents column was added each stand for one spawn.
        a[0] += int(r.get("agents") or 1)
        for i, k in enumerate(("input", "cache_write", "cache_read", "output", "output_est"), 1):
            a[i] += int(r.get(k) or 0)
    tot = collections.defaultdict(lambda: [0, 0, 0, 0, 0])
    # "~": some of the output was estimated from the transcript's text and is a lower bound.
    out = lambda n, est: f"{n:>7}" + ("~" if est > 0 else "")
    for (agent, model), a in sorted(agg.items()):
        print(f"  {agent:20} {model:12} x{a[0]:<2} in={a[1]:>7} cache_write={a[2]:>8} cache_read={a[3]:>9} out={out(a[4], a[5])}")
        t = tot[model]
        for i in range(5):
            t[i] += a[i + 1]
    for model, t in sorted(tot.items()):
        print(f"  {'TOTAL':20} {model:12}     in={t[0]:>7} cache_write={t[1]:>8} cache_read={t[2]:>9} out={out(t[3], t[4])}")
    if any(t[4] > 0 for t in tot.values()):
        print("  ~ = includes output estimated from the transcript text (hidden thinking not counted)")
PY
}

# Summarize the cope:profile block that cope-profiler writes into CLAUDE.md.
cmd_profile() {
  local root f
  root=$(main_root 2>/dev/null) || root=$PWD
  f=$root/CLAUDE.md
  if [[ ! -f $f ]] || ! grep -q '^<!-- cope:profile -->' "$f"; then echo "PROFILE: none"; return 0; fi
  echo "PROFILE: present"
  sed -n '/^<!-- cope:profile -->/,/^<!-- \/cope:profile -->/p' "$f" | sed -nE '
    s/^- Check: *`?([^`]*)`? *$/CHECK: \1/p
    s/^- Test signal: *([a-z-]+).*$/SIGNAL: \1/p
    s/^- Oracle: *(.*)$/ORACLE: \1/p
    s/^- Hazards: *(.*)$/HAZARDS: \1/p
    s/^- Baseline: *(.*)$/BASELINE: \1/p'
}

# Files under the given paths: tracked plus untracked-but-not-ignored in a git tree, everything outside one.
rule_files() {
  if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    git ls-files -co --exclude-standard -z -- "$@"
  else
    find "$@" -type f -print0
  fi
}

# Line-comment style by file name; "none" means not a known source language.
comment_mode() {
  case ${1##*/} in
    *.c|*.h|*.cc|*.cpp|*.cxx|*.hpp|*.cs|*.java|*.js|*.jsx|*.mjs|*.cjs|*.ts|*.tsx|*.go|*.rs|*.kt|*.kts|*.swift|*.scala|*.dart|*.php|*.css|*.scss|*.less) echo c ;;
    *.py|*.sh|*.bash|*.zsh|*.rb|*.pl|*.yaml|*.yml|*.toml|*.r|*.R|*.ps1|*.cmake|*.mk|Makefile|Dockerfile) echo hash ;;
    *.sql|*.lua|*.hs) echo dash ;;
    *) echo none ;;
  esac
}

# Blank out comment text, keeping line numbers. A heuristic: markers inside strings count as comments.
strip_comments() {
  awk -v m="$1" '
    m == "c" {
      out = ""; s = $0
      while (s != "") {
        if (inb) { i = index(s, "*/"); if (!i) break; s = substr(s, i + 2); inb = 0; continue }
        i = index(s, "/*"); j = index(s, "//")
        if (j && (!i || j < i)) { out = out substr(s, 1, j - 1); break }
        if (i) { out = out substr(s, 1, i - 1); s = substr(s, i + 2); inb = 1; continue }
        out = out s; break
      }
      print out; next
    }
    m == "hash" { i = index($0, "#");  print (i ? substr($0, 1, i - 1) : $0); next }
    m == "dash" { i = index($0, "--"); print (i ? substr($0, 1, i - 1) : $0); next }
    { print }'
}

rule_args() {
  local re=$1 p rc=0; shift
  (($#)) || die "a rule needs REGEX and at least one PATH"
  grep -qE -- "$re" /dev/null 2>/dev/null || rc=$?
  ((rc < 2)) || die "invalid regex: $re"
  for p in "$@"; do [[ -e $p ]] || die "no such path: $p"; done
}

# Rule check: fail, listing the matches, if REGEX appears under PATH. --code: source files only, comments ignored.
cmd_forbid() {
  local code=0 re f m hits=""
  [[ ${1:-} == --code ]] && { code=1; shift; }
  re=${1:-}; shift || true
  rule_args "$re" "$@"
  while IFS= read -r -d '' f; do
    [[ -f $f ]] && grep -qIE -- "$re" "$f" || continue
    if ((code)); then
      [[ $(comment_mode "$f") != none ]] || continue
      m=$(strip_comments "$(comment_mode "$f")" <"$f" | grep -nE -- "$re") || true
    else
      m=$(grep -nE -- "$re" "$f") || true
    fi
    [[ -n $m ]] && hits+=$(sed "s|^|$f:|" <<<"$m")$'\n'
  done < <(rule_files "$@")
  if [[ -n $hits ]]; then
    echo "FORBIDDEN /$re/ found:"
    head -n 20 <<<"${hits%$'\n'}"
    return 1
  fi
  echo "OK forbid /$re/"
}

# Rule check: fail unless REGEX appears somewhere under PATH.
cmd_require() {
  local re=${1:-} f; shift || true
  rule_args "$re" "$@"
  while IFS= read -r -d '' f; do
    if [[ -f $f ]] && grep -qIE -- "$re" "$f"; then echo "OK require /$re/ ($f)"; return 0; fi
  done < <(rule_files "$@")
  echo "MISSING /$re/ under: $*"
  return 1
}

cmd_list() {
  local d
  d=$(cache_dir)
  [[ -d $d ]] || return 0
  find "$d" -mindepth 1 -maxdepth 1 -type d ! -name '.*' | sort
}

# Python projects: make the worktree's code win the import, and refuse to PASS if it doesn't.
python_guard() {
  local wt=$1 pkg py out
  [[ -f $wt/pyproject.toml ]] || return 0
  pkg=$(python3 -I -c 'import sys,tomllib;print(tomllib.load(open(sys.argv[1],"rb")).get("project",{}).get("name",""))' "$wt/pyproject.toml" 2>/dev/null || true)
  [[ -n $pkg ]] || return 0
  pkg=${pkg//-/_}; pkg=${pkg//./_}
  py=python3; [[ -x $wt/.venv/bin/python ]] && py=$wt/.venv/bin/python
  # -P: don't put the cwd on sys.path, so resolution matches what a test runner sees via PYTHONPATH.
  "$py" -P -c '' 2>/dev/null && py="$py -P"
  out=$(cd "$wt" && $py -c "import os,$pkg as m;print(os.path.realpath(getattr(m,'__file__',None) or list(m.__path__)[0]))" 2>/dev/null) || return 0
  [[ $out == "$(realpath "$wt")"/* ]] || { echo "import of '$pkg' resolves outside the worktree: $out"; return 1; }
}

verify_one() {
  local wt=$1 oracle=$2; shift 2
  local snap sha log status=PASS detail="" c g
  snap=$(snap_sha) || die "no snapshot; run cope-wt snapshot first"
  sha=$(tree_commit "$wt" "$snap")   # before the checks run, so their artifacts aren't part of the candidate
  log=$(mktemp)
  (
    cd "$wt"
    if [[ -f pyproject.toml || -f setup.py || -f setup.cfg ]]; then
      export PYTHONPATH="$wt${PYTHONPATH:+:$PYTHONPATH}"
      [[ -d src ]] && export PYTHONPATH="$wt/src:$PYTHONPATH"
    fi
    if [[ -n $oracle ]] && ! git diff --quiet "$snap" -- $oracle; then
      echo "ORACLE-TAMPERED: $(git diff --name-only "$snap" -- $oracle | tr '\n' ' ')"; exit 3
    fi
    g=$(python_guard "$wt") || { echo "$g"; exit 4; }
    for c in "$@"; do
      echo "\$ $c"
      timeout "$CHECK_TIMEOUT" bash -c "$c" || { echo "[exit $?] $c"; exit 1; }
    done
  ) >"$log" 2>&1 || {
    case $? in 3) status=TAMPERED ;; 4) status=ENV-FAIL ;; *) status=FAIL ;; esac
    detail=$(tail -n 15 "$log")
  }
  rm -f "$log"
  local stat
  stat=$(git diff --numstat "$snap" "$sha" | awk '{f++; a+=$1; d+=$2} END{if (f) printf "%d files +%d -%d", f, a, d}')
  [[ -n $stat ]] || { stat="no changes"; [[ $status == PASS ]] && status=NO-CHANGE; }
  printf '%s %s %s | %s\n' "$status" "$sha" "$wt" "$stat"
  [[ -n $detail ]] && sed 's/^/    /' <<<"$detail"
  return 0
}

# Prints IDENTICAL <sha> | TOO-LARGE <sha> ... | DISTINCT <n> ..., or the full diffs.
diffs_core() {
  local summary=$1; shift
  local snap s
  snap=$(snap_sha) || die "no snapshot"
  local -A seen=(); local total=0 smallest="" small_n=-1 n h
  for s in "$@"; do
    h=$(git diff -w -U0 "$snap" "$s" | grep -E '^[+-]' | tr -d '[:space:]' | sha1sum | cut -c1-12)
    seen[$h]=1
    n=$(git diff --numstat "$snap" "$s" | awk '{a+=$1+$2} END{print a+0}')
    total=$((total + n))
    if ((small_n < 0 || n < small_n)); then small_n=$n; smallest=$s; fi
  done
  if ((${#seen[@]} == 1)); then echo "IDENTICAL $smallest"; return; fi
  if ((total > MAX_DIFF_LINES)); then echo "TOO-LARGE $smallest ($total lines; picked smallest)"; return; fi
  if ((summary)); then echo "DISTINCT ${#seen[@]} ($total lines)"; return; fi
  for s in "$@"; do
    echo "===== CANDIDATE $s"
    git diff --stat=100 "$snap" "$s" | tail -n 1
    git diff -U3 "$snap" "$s"
  done
}

cmd_verify() {
  local checks=() oracle="" parallel=0 all=0 wts=() explicit=0 do_apply=0
  while (($#)); do
    case $1 in
      --checks) checks+=("$2"); shift 2 ;;
      --oracle) oracle=$2; shift 2 ;;
      --parallel) parallel=1; shift ;;
      --all) all=1; shift ;;
      --apply) do_apply=1; shift ;;
      *) wts+=("$1"); explicit=1; shift ;;
    esac
  done
  ((${#checks[@]})) || die "verify needs at least one --checks command"
  local res wt name
  res="$(cache_dir)/.results"; mkdir -p "$res"
  if ((!explicit)); then
    while IFS= read -r wt; do
      name=$(basename "$wt")
      ((all)) || [[ ! -f $res/$name ]] && wts+=("$wt")
    done < <(cmd_list)
  fi
  if ((${#wts[@]} == 0)) && [[ -z $(cmd_list) ]]; then
    die "NO-CANDIDATES: no worktrees under $(cache_dir). The WorktreeCreate hook is probably not installed (run install.sh --hooks)."
  fi
  if ((parallel)); then
    for wt in "${wts[@]}"; do verify_one "$wt" "$oracle" "${checks[@]}" >"$res/$(basename "$wt")" & done
    wait
  else
    for wt in "${wts[@]}"; do verify_one "$wt" "$oracle" "${checks[@]}" >"$res/$(basename "$wt")"; done
  fi
  local batch_pass=0
  for wt in "${wts[@]}"; do
    cat "$res/$(basename "$wt")"
    grep -q '^PASS ' "$res/$(basename "$wt")" && batch_pass=$((batch_pass + 1))
  done
  # Decision over every candidate verified in this run so far (earlier batches included).
  local pass=() total=0 f s sha
  for f in "$res"/*; do
    [[ -f $f ]] || continue
    total=$((total + 1))
    read -r s sha _ < "$f"
    [[ $s == PASS ]] && pass+=("$sha")
  done
  echo "PASSED ${#pass[@]}/$total (this batch: $batch_pass/${#wts[@]})"
  if ((${#pass[@]} == 0)); then
    echo "DECISION: NONE-PASSED"
    return 0
  fi
  local pick="" d
  if ((${#pass[@]} == 1)); then
    pick=${pass[0]}; echo "DECISION: APPLY $pick"
  else
    d=$(diffs_core 1 "${pass[@]}")
    case $d in
      IDENTICAL*|TOO-LARGE*) pick=$(awk '{print $2}' <<<"$d"); echo "DECISION: APPLY $pick ($d)" ;;
      *) echo "DECISION: PICK ${pass[*]} ($d)" ;;
    esac
  fi
  if [[ -n $pick ]] && ((do_apply)); then
    cmd_apply "$pick" && cmd_cleanup --final
  fi
}

cmd_diffs() {
  local summary=0
  [[ ${1:-} == --summary ]] && { summary=1; shift; }
  (($#)) || die "diffs needs candidate SHAs"
  diffs_core "$summary" "$@"
}

cmd_apply() {
  local sha=${1:?usage: cope-wt apply SHA} snap root patch
  snap=$(snap_sha) || die "no snapshot"
  root=$(main_root)
  patch="$(cache_dir).patch"
  mkdir -p "$(dirname "$patch")"
  git -C "$root" diff --binary "$snap" "$sha" >"$patch"
  if git -C "$root" apply --check "$patch" 2>/dev/null; then
    git -C "$root" apply "$patch"
    rm -f "$patch"
    echo "APPLIED $sha"
    git -C "$root" diff --stat "$snap" "$sha" | tail -n 1
  else
    echo "CONFLICT: main tree changed since the snapshot; patch saved at $patch"
    git -C "$root" apply --check "$patch" 2>&1 | head -n 10 || true
    return 1
  fi
}

# The brief lives in the main repo's git dir: readable from every worktree, invisible to git and test runners.
run_state_dir() { echo "$(common_dir)/cope/$RUN"; }

cmd_brief() {
  local f
  f="$(run_state_dir)/brief.md"
  case ${1:-} in
    save) mkdir -p "$(dirname "$f")"; cat > "$f"; [[ -s $f ]] || die "empty brief"; echo "$f" ;;
    path) [[ -f $f ]] || die "no brief saved for this run"; echo "$f" ;;
    *) die "usage: cope-wt brief save|path" ;;
  esac
}

cleanup_run() {
  local wt n=0
  while IFS= read -r wt; do
    git worktree remove --force "$wt" 2>/dev/null || rm -rf "$wt"
    n=$((n + 1))
  done < <(cmd_list)
  rm -rf "$(cache_dir)/.results"
  rmdir "$(cache_dir)" 2>/dev/null || true
  git update-ref -d "$(snap_ref)" 2>/dev/null || true
  echo "$n"
}

cmd_cleanup() {
  local n=0 ref
  if [[ ${1:-} == --all ]]; then
    local d
    for d in "$(repo_cache_dir)"/*/; do
      [[ -d $d ]] || continue
      RUN=$(basename "$d"); n=$((n + $(cleanup_run)))
    done
    while IFS= read -r ref; do git update-ref -d "$ref"; done < <(git for-each-ref --format='%(refname)' 'refs/cope/')
    rm -rf "$(common_dir)/cope"
  else
    n=$(cleanup_run)
    [[ ${1:-} == --final ]] && rm -rf "$(run_state_dir)"
  fi
  git worktree prune
  rmdir "$(repo_cache_dir)" 2>/dev/null || true
  echo "CLEANED $n worktree(s)"
}

case ${1:-} in
  snapshot) shift; cmd_snapshot "$@" ;;
  hook-create) shift; cmd_hook_create "$@" ;;
  hook-remove) shift; cmd_hook_remove "$@" ;;
  hook-usage) shift; cmd_hook_usage "$@" ;;
  list) shift; cmd_list "$@" ;;
  verify) shift; cmd_verify "$@" ;;
  diffs) shift; cmd_diffs "$@" ;;
  apply) shift; cmd_apply "$@" ;;
  cleanup) shift; cmd_cleanup "$@" ;;
  report) shift; cmd_report "$@" ;;
  log) shift; cmd_log "$@" ;;
  brief) shift; cmd_brief "$@" ;;
  profile) shift; cmd_profile "$@" ;;
  forbid) shift; cmd_forbid "$@" ;;
  require) shift; cmd_require "$@" ;;
  *) sed -n '2,25p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
